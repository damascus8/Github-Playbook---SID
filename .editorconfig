# EditorConfig: consistent whitespace across editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{java,js,jsx,ts,tsx,css,scss,html,xml,py,sh,sql}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
